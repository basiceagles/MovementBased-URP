    m_Metadata:
      m_Items: []
  - m_Id: 1008279740416
    m_Localized: "\u041D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 \u043F\u043E\u0432\u0441\u044E\u0434\u0443
      \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442 \u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u0448\u0443\u043C\u043D\u044B\u0435 \u043D\u043E\u0434\u044B.\r\n\r\n\n\u0417\u0430
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443 \u043D\u043E\u0434 \u043D\u0430
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u043C\u0430\u0448\u0438\u043D\u0443
      \xAB\u041F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u043D\u043E\u0434\xBB
      \u0432\u0430\u043C \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
      \u0431\u043E\u043D\u0443\u0441\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F.
      \u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0430
