    m_Metadata:
      m_Items: []
  - m_Id: 2022001074176
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u0435\u0439 \u0438 \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u044C
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C, \u0434\u0432\u0438\u0433\u0430\u044F\u0441\u044C
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u043D\u0430\u0437\u0430\u0434.\r\n\r\n\n\u041C\u043E\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
