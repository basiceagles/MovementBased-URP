  - m_Id: 3107872825344
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u0440\u044E\u043A-\u043A\u043E\u0448\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0438\u0433\u0440\u043E\u043A\u0443 \u0446\u0435\u043F\u043B\u044F\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0435
      \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.
      \u0423 \u043A\u0440\u044E\u043A\u0430-\u043A\u043E\u0448\u043A\u0438 \u0435\u0441\u0442\u044C
      \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438.
      \n\n\u0415\u0433\u043E \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E
