  m_TableData:
  - m_Id: 68457848832
    m_Localized: Nothing, pure nothing... Just continue the game.
    m_Metadata:
      m_Items: []
  - m_Id: 232589352960
    m_Localized: 'Benefits: None.'
    m_Metadata:
      m_Items: []
  - m_Id: 272665927680
    m_Localized: 'Losses: None.'
    m_Metadata:
      m_Items: []
  - m_Id: 1008279740416
    m_Localized: 'Starts to spawn red noisy nodes everywhere at the level.



      Delivering
      nodes to the special "Node Handler" machine will give you some amount of time.
      The default is 15 seconds.'
    m_Metadata:
      m_Items: []
  - m_Id: 1070716149760
    m_Localized: 'Benefits: Spawns nodes.'
    m_Metadata:
      m_Items: []
  - m_Id: 1099476492288
    m_Localized: 'Losses: + 2 Extra levels every cycle.'
    m_Metadata:
      m_Items: []
  - m_Id: 2022001074176
    m_Localized: 'Allows you to use a rope and swing on it to gain velocity by moving
      forward and backward.



      Can only be used on designated yellow marks.'
    m_Metadata:
      m_Items: []
  - m_Id: 2078741618688
    m_Localized: 'Benefits: Allows to use rope swinging.'
    m_Metadata:
      m_Items: []
  - m_Id: 2101202116608
    m_Localized: 'Losses: Adds rope swinging-based levels to generation.'
    m_Metadata:
      m_Items: []
  - m_Id: 9232437469184
    m_Localized: Gives some time in exchange for extra levels.
    m_Metadata:
      m_Items: []
  - m_Id: 9127844110336
    m_Localized: Gives some time in exchange for extra levels.
    m_Metadata:
      m_Items: []
  - m_Id: 9042146091008
    m_Localized: Gives some time in exchange for extra levels.
    m_Metadata:
      m_Items: []
  - m_Id: 9148337479680
    m_Localized: 'Benefits: + 40 seconds to timer.'
    m_Metadata:
      m_Items: []
  - m_Id: 9173272616960
    m_Localized: 'Losses: + 20 extra levels.'
    m_Metadata:
      m_Items: []
  - m_Id: 9080020656128
    m_Localized: 'Benefits: + 20 seconds to timer.'
    m_Metadata:
      m_Items: []
  - m_Id: 9105421361152
    m_Localized: 'Losses: + 10 extra levels.'
    m_Metadata:
      m_Items: []
  - m_Id: 9265975123968
    m_Localized: 'Losses: + 30 extra levels.'
    m_Metadata:
      m_Items: []
  - m_Id: 9249344708608
    m_Localized: 'Benefits: + 60 seconds to timer.'
    m_Metadata:
      m_Items: []
  - m_Id: 9746894020608
    m_Localized: Adds additional modificators in modificator choice menu.
    m_Metadata:
      m_Items: []
  - m_Id: 9796877541376
    m_Localized: 'Benefits: Adds +1 to modificator amount.'
    m_Metadata:
      m_Items: []
  - m_Id: 9824505421824
    m_Localized: 'Losses: +1 Level to spawn every cycle.'
    m_Metadata:
      m_Items: []
  - m_Id: 3591077617664
    m_Localized: 'Losses: Adds rope grapple-based levels to generation.'
    m_Metadata:
      m_Items: []
  - m_Id: 3569145602048
    m_Localized: 'Benefits: Allows to use rope grapple.'
    m_Metadata:
      m_Items: []
  - m_Id: 3107872825344
    m_Localized: "Adds a grapple hook that allows the player to grapple to designated
      surfaces. The grapple hook has a cooldown. \n\nIt can also be used to activate
      levers."
    m_Metadata:
      m_Items: []
  - m_Id: 11753197395968
    m_Localized: 'Watchers begin to spawn. You can spot them by the large amount
      of yellow light and the big eye floating in the air.

      

      Be careful!
      Looking at a watcher for more than one second will immediately damage or even
      kill you.'
    m_Metadata:
      m_Items: []
  - m_Id: 11791382339584
    m_Localized: 'Benefits: + 20 seconds to timer.'
    m_Metadata:
      m_Items: []
  - m_Id: 11922030714880
