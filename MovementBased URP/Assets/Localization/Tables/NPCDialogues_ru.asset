  m_TableData:
  - m_Id: 577637965824
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 555143913472
    m_Localized: "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F,
      \u0410\u0440\u0433\u0443\u0441 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430\u0441 \u0437\u0434\u0435\u0441\u044C.
      \u0423 \u043C\u0435\u043D\u044F, \u043A\u0441\u0442\u0430\u0442\u0438, \u0435\u0441\u0442\u044C
      \u043A\u043E\u0435-\u0447\u0442\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 30772027392
    m_Localized: "\u0422\u044B \u0443\u043C\u0435\u0440 \u0438\u0437-\u0437\u0430
      \u043D\u0435\u0434\u043E\u0434\u0441\u0442\u0430\u0442\u043A\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 550312075264
    m_Localized: "\u041D\u0430 \u0447\u0442\u043E \u0442\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B?
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
      \u0431\u0443\u0434\u044C \u0447\u0443\u0442\u044C \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 39704643231744
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 39694354604032
    m_Localized: "\u042D\u0442\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0441\u043E\u0432\u0435\u0442 \u043E\u0442 \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 39639769931776
    m_Localized: "\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
      \u0431\u0443\u0434\u044C \u043F\u043E\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435,
      \u043F\u0440\u044B\u0433\u0430\u044F \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0432\u044B\u0441\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 40959943892992
    m_Localized: "\u0422\u0435\u0431\u044F \u0443\u0431\u0438\u043B \u0420\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 40991183069184
    m_Localized: "\u0420\u0430\u0448 \u0431\u044B\u0441\u0442\u0440\u044B\u0439,
      \u043D\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u043F\u043E\u043F\u044B\u0442\u0430\u0439\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043D\u0430\u0439\u0434\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u0435,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0420\u0430\u0448
      \u043D\u0430\u0441\u0442\u0438\u0433\u0435\u0442 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 41004558704640
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 50544071139328
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 50636098363392
    m_Localized: "\u0425\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0441\u0442\u0438
      \u043F\u0435\u0440\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 50514983641088
    m_Localized: "\u0428\u043E\u043F\u043F\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 12030736217321472
    m_Localized: "\u0414\u0432\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12031508464185344
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 12031828950953984
    m_Localized: "[\u041F\u0440\u043E\u0448\u0443, \u043E\u0431\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430\u0437\u0430\u0434.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12073746648969216
    m_Localized: "\u0410\u0440\u0433\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 12074705412337664
    m_Localized: "\u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?
      \u0413\u0434\u0435 \u044F?<color=#FFA500>"
    m_Metadata:
      m_Items: []
  - m_Id: 12075409656950784
    m_Localized: "[\u0412\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C
      \u0432 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u043C \u043C\u0438\u0440\u0435
      Vanitas, \u0432\u044B \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390026794938368
    m_Localized: "[\u042F - \u0410\u0440\u0433\u0443\u0441, \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C.
      \u042F \u0431\u0443\u0434\u0443 \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0442\u044C
      \u0432\u0430\u0441 \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u0443\u0442\u0438.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390089411702784
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u0437\u0434\u0435\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 12390194831339520
    m_Localized: "[\u0412\u044B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0433\u0435\u0440\u043E\u0439 \u0441\u0432\u043E\u0435\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F \u043D\u0430 \u0446\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044E
      \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390246530330624
    m_Localized: "[\u0412\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
      \u043D\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0430,
      \u0438 \u0432\u0430\u0448\u0430 \u043C\u0438\u0441\u0441\u0438\u044F - \u043F\u043E\u043C\u043E\u0447\u044C
      \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u0432\u0430\u043A\u0446\u0438\u043D\u0443
      \u043E\u0442 \u0432\u0438\u0440\u0443\u0441\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0435\u0440\u043E\u043B\u043E\u043C\u043D\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0448 \u0432\u0438\u0434.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390349131395072
    m_Localized: "[\u0412\u044B \u043D\u0430\u0448\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u0430,
      \u043D\u0430\u0448 \u0448\u0430\u043D\u0441 \u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0435
      \u0431\u0443\u0434\u0443\u0449\u0435\u0435.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390386473283584
    m_Localized: "[\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0432\u0430\u0448
      \u0432\u043A\u043B\u0430\u0434.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390436297420800
    m_Localized: "\u042D-\u044D-\u044D. \u044F \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u043C\u043D\u044E \u043E\u0431 \u044D\u0442\u043E\u043C.
      \u0412\u044B \u0443\u0432\u0435\u0440-"
    m_Metadata:
      m_Items: []
  - m_Id: 12390530606346240
    m_Localized: "[\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0430\u043C\u043D\u0435\u0437\u0438\u044F
      - \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u043E\u0432
      \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430.
      \u0421\u043A\u043E\u0440\u043E \u0432\u044B \u0432\u0441\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u0435.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390578513686528
    m_Localized: "\u0422\u0430-\u0430-\u043A. \u0410 \u044F. \u043D\u0443, \u044D\u0442\u043E.
      \u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043C\u043E\u0433\u0443,
      \u0435\u0441\u043B\u0438 \u0447\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 12390713209565184
    m_Localized: "[\u041A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435, \u0432\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F!
      \u0412\u0430\u043C \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C
      \u043D\u0430\u0434\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0430\u0440\u0443 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u0438\u0437
      \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430,
      \u0438 \u0442\u043E\u0433\u0434\u0430 \u043C\u044B \u0441 \u043B\u0435\u0433\u043A\u043E\u0441\u0442\u044C\u044E
      \u0432\u0435\u0440\u043D\u0435\u043C \u0432\u0430\u0441 \u0434\u043E\u043C\u043E\u0439.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390766573694976
    m_Localized: "\u042F \u043C\u043E\u0433\u0443 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 12390798823698432
    m_Localized: "[\u041A\u043E\u043D\u0435\u0447\u043D\u043E.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390835230257152
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0447\u0442\u043E \u043C\u043D\u0435
      \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 12390883515084800
    m_Localized: "[\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12390978490904576
    m_Localized: "[\u0417\u0434\u0435\u0441\u044C \u0432\u0430\u0441 \u043E\u0431\u0443\u0447\u0430\u0442
      \u0431\u0430\u0437\u043E\u0432\u043E\u043C\u0443 \u0444\u0443\u043D\u043A\u0446\u0438\u0430\u043D\u0430\u043B\u0443
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391123492188160
    m_Localized: "[\u042D\u0442\u043E \u0445\u0430\u0431. \u0421\u0435\u0440\u0434\u0446\u0435
      \u044D\u0442\u043E\u0439 \u044F\u0447\u0435\u0439\u043A\u0438. \u0417\u0434\u0435\u0441\u044C
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      \u043B\u044E\u0431\u0438\u043C\u044B\u043C\u0438 \u0434\u0435\u043B\u0430\u043C\u0438
      \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043E\u0442
      \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0440\u0435\u043C\u044F.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391163644260352
    m_Localized: "[\u0410 \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0442\u0432\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430. \u041A\u0430\u043A
      \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432, \u0437\u0430\u0439\u0434\u0438
      \u0432 \u0442\u0443 \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0443 \u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391205608271872
    m_Localized: "[\u041D\u0443 \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C. \u042D\u0442\u043E \u0442\u0432\u043E\u0439
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437, \u0442\u0430\u043A
      \u0447\u0442\u043E... \u041E\u0442\u043B\u0438\u0447\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391244590133248
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0432\u043E\u043F\u0440\u043E\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 12391293697044480
    m_Localized: "[\u041A\u043E\u043D\u0435\u0447\u043D\u043E.]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391343202414592
    m_Localized: "\u0430 \u043A\u0430\u043A \u0441\u0432\u044F\u0437\u0430\u043D\u044B
      \u0437\u0430\u0431\u0435\u0433\u0438 \u0438 \u043F\u043E\u0438\u0441\u043A
      \u0432\u0430\u043A\u0446\u0438\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 12391492305727488
    m_Localized: "[\u0421\u043B\u0443\u0448\u0430\u0439, \u0443 \u043C\u0435\u043D\u044F
      \u043C\u043D\u043E\u0433\u043E \u0434\u0435\u043B, \u0442\u0430\u043A \u0447\u0442\u043E
      \u0434\u0430\u0432\u0430\u0439 \u044F \u043E\u0442\u0432\u0435\u0447\u0443
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437, \u043B\u0430\u0434\u043D\u043E?]"
    m_Metadata:
      m_Items: []
  - m_Id: 12391543316852736
    m_Localized: "[\u041A \u0442\u043E\u043C\u0443 \u0436\u0435 \u044D\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
