  - m_Id: 14970530358538240
    m_Localized: "\u0413\u0434\u0435 \u044D\u0442\u043E \u043C\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 14970568946135040
    m_Localized: "[\u042D\u0442\u043E \u0445\u0430\u0431. \u0421\u0435\u0440\u0434\u0446\u0435
      \u044D\u0442\u043E\u0439 \u044F\u0447\u0435\u0439\u043A\u0438. \u0417\u0434\u0435\u0441\u044C
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      \u043B\u044E\u0431\u0438\u043C\u044B\u043C\u0438 \u0434\u0435\u043B\u0430\u043C\u0438
      \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043E\u0442
      \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0440\u0435\u043C\u044F.]"
    m_Metadata:
      m_Items: []
  - m_Id: 14970593168240640
    m_Localized: "\u041E\u0431\u0449\u0430\u0442\u044C\u0441\u044F? \u0421 \u043A\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 14970607965745152
    m_Localized: "[\u0414\u0430... \u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u0443\u0442
      \u043F\u0443\u0441\u0442\u043E\u0432\u0430\u0442\u043E. \u041D\u043E \u0441\u043A\u043E\u0440\u043E
      \u044D\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F.]"
    m_Metadata:
      m_Items: []
  - m_Id: 14971588317196288
    m_Localized: "[\u0423 \u043C\u0435\u043D\u044F \u043C\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0442\u0430\u043A \u0447\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043F\u0440\u043E\u0449\u0430\u044E\u0441\u044C. \u0423\u0434\u0430\u0447\u0438
      \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0439 \u0441\u043C\u0435\u043D\u0435]"
    m_Metadata:
      m_Items: []
  - m_Id: 14977238489280512
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 14977115717808128
    m_Localized: "\u0422\u0430\u043A \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430.
      \u041D\u043E\u0432\u044B\u0439 \u0431\u0435\u0433\u0443\u043D. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u0436\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0448\u043B\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 14977149221908480
    m_Localized: "\u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u044D\u0442\u043E
      \u0441\u043A\u0430\u0437\u0430\u043B? \u0422\u044B \u0447\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 14977154225713152
    m_Localized: "\u041D\u0435\u0442, \u044F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
      \u0442\u0430\u043A \u0432\u044B\u0433\u043B\u044F\u0436\u0443. \u0421\u043A\u0443\u0447\u043D\u0430\u044F
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 14977195359252480
    m_Localized: "\u042F \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446, \u044D\u0442\u043E
      \u043C\u043E\u044F \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 14977205819846656
    m_Localized: "\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043A\u0430 \u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u043C\u043E\u0438 \u0442\u043E\u0432\u0430\u0440\u044B, \u044F \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0443."
