      \u0434\u0440\u0443\u0433\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 9747237075148800
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \"Shift\"
      \u0438 \"C\" \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442\u044C
      \u043F\u043E \u043D\u0430\u043A\u043B\u043E\u043D\u043D\u044B\u043C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 9747453979385856
    m_Localized: "\u041F\u0440\u044B\u0433\u043D\u0443\u0432 \u043D\u0430 \u0441\u0442\u0435\u043D\u0443
      \u0432 \u0431\u0435\u0433\u0435, \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435
      \u0431\u0435\u0436\u0430\u0442\u044C \u043F\u043E \u0441\u0442\u0435\u043D\u0435,
      \u043F\u043E\u043A\u0430 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0435\u0441\u044C
      \u0432\u043F\u0435\u0440\u0435\u0434 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \u0431\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 9747602201894912
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \"Shift\"
