    m_Metadata:
      m_Items: []
  - m_Id: 10558797574037504
    m_Localized: "\u0418\u0433\u0440\u0430 Verdge \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u043D\u043D\u0438\u0445 \u0441\u0442\u0430\u0434\u0438\u044F\u0445
      \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B \u043E\u0448\u0438\u0431\u043A\u0438
      \u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430.
      \u0418\u0433\u0440\u0430 \u0432 \u044D\u0442\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u0432\u0435\u0440\u0441\u0438\u0435\u0439. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0439
      \u0438\u0433\u0440\u044B!\n\n\u0422\u0430\u043A\u0436\u0435 \u0438\u0433\u0440\u0430
      \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u0430 \u0431\u044B\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
