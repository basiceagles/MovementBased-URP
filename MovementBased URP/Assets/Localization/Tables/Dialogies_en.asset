  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogies_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d8d5e4f8d4055874bb2714bf31f3dbc1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 881494319104
    m_Localized: How do you describe your feeling right now?
    m_Metadata:
      m_Items: []
  - m_Id: 7015559061504
    m_Localized: Are you expereincing any pain,
    m_Metadata:
      m_Items: []
  - m_Id: 7040812965888
    m_Localized: headache,
    m_Metadata:
      m_Items: []
  - m_Id: 38007111933952
    m_Localized: or other unpleasent symphtoms?
    m_Metadata:
      m_Items: []
  - m_Id: 261744755204096
    m_Localized: Detecting irregular brain activity stemming from a form of fear.
    m_Metadata:
      m_Items: []
  - m_Id: 261757774323712
    m_Localized: Now analyzing and transmitting the report to the VERDGE database.
    m_Metadata:
      m_Items: []
  - m_Id: 269268854235136
    m_Localized: "Don\u2019t be shy; you can say anything you feel or want to say
      to me."
    m_Metadata:
      m_Items: []
  - m_Id: 269382297575424
    m_Localized: "Maybe you don\u2019t like me,"
    m_Metadata:
      m_Items: []
  - m_Id: 269580184838144
    m_Localized: or I need to change the pitch of my voice.
    m_Metadata:
      m_Items: []
  - m_Id: 270054862610432
    m_Localized: Everything will be useful for VERDGE.
    m_Metadata:
      m_Items: []
  - m_Id: 270138543169536
    m_Localized: Oops, sorry,
    m_Metadata:
      m_Items: []
  - m_Id: 270481939226624
    m_Localized: "I forgot you aren\u2019t able to answer questions."
    m_Metadata:
      m_Items: []
  - m_Id: 270497231659008
    m_Localized: "We haven\u2019t implemented that yet."
    m_Metadata:
      m_Items: []
  - m_Id: 270566882271232
    m_Localized: Never mind...
    m_Metadata:
      m_Items: []
  - m_Id: 6093433792356352
    m_Localized: Hello and welcome to the VERDGE training centre!
    m_Metadata:
      m_Items: []
  - m_Id: 6093694048919552
    m_Localized: Todaw you will learn basic movements and simulation rules.
    m_Metadata:
      m_Items: []
  - m_Id: 6094028876013568
    m_Localized: Please follow the steps written ahead of you.
    m_Metadata:
      m_Items: []
  - m_Id: 6094093636067328
    m_Localized: Thanks for your cooperation, your contribution will not be forgotten.
    m_Metadata:
      m_Items: []
  - m_Id: 6095671050887168
    m_Localized: Congratulations on finishing your first stage.
    m_Metadata:
      m_Items: []
  - m_Id: 6096071296540672
    m_Localized: Now you are ready for a full stress test!
    m_Metadata:
      m_Items: []
  - m_Id: 6096358241460224
    m_Localized: Warning, the VERDGE agreement warranty doesn't cover any problems
    m_Metadata:
      m_Items: []
  - m_Id: 6096812723658752
    m_Localized: ' caused by psychological damage.'
    m_Metadata:
      m_Items: []
  - m_Id: 6097093171601408
    m_Localized: At persections 2.3, 2.4 and 2.5.
    m_Metadata:
      m_Items: []
  - m_Id: 6097893448998912
    m_Localized: 'Initializing program restart in:'
    m_Metadata:
      m_Items: []
  - m_Id: 6098286786633728
    m_Localized: 3...
    m_Metadata:
      m_Items: []
  - m_Id: 6098318021615616
    m_Localized: 2...
    m_Metadata:
      m_Items: []
  - m_Id: 6098350191927296
    m_Localized: 1...
    m_Metadata:
      m_Items: []
  references:
    version: 2
