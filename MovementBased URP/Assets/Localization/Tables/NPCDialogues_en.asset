MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NPCDialogues_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: fe9b4044e4be1b641ac317d4f863bb2d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 30772027392
    m_Localized: You have died to a loss of time.
    m_Metadata:
      m_Items: []
  - m_Id: 550312075264
    m_Localized: What did you expect? Next time try to be faster.
    m_Metadata:
      m_Items: []
  - m_Id: 555143913472
    m_Localized: Don't worry. Aurgus cannot see us here. Also I have something for
      you...
    m_Metadata:
      m_Items: []
  - m_Id: 577637965824
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 39704643231744
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 39639769931776
    m_Localized: Next time can you watch your step and don't jump from high heights.
    m_Metadata:
      m_Items: []
  - m_Id: 39694354604032
    m_Localized: This is a small advice from me.
    m_Metadata:
      m_Items: []
  - m_Id: 40959943892992
    m_Localized: You have died to a Rush.
    m_Metadata:
      m_Items: []
  - m_Id: 40991183069184
    m_Localized: Rush is fast, but next time try to find a shelter faster that it
      will catch you.
    m_Metadata:
      m_Items: []
  - m_Id: 41004558704640
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 50544071139328
    m_Localized: Hello!
    m_Metadata:
      m_Items: []
  - m_Id: 50636098363392
    m_Localized: Do you want buy some perks?
    m_Metadata:
      m_Items: []
  - m_Id: 50514983641088
    m_Localized: Shopper
    m_Metadata:
      m_Items: []
  - m_Id: 5523247154585600
    m_Localized: Did you realise what happened?
    m_Metadata:
      m_Items: []
  - m_Id: 5523343371919360
    m_Localized: Why you did this?
    m_Metadata:
      m_Items: []
  - m_Id: 5523383284916224
    m_Localized: Why you did destroy the entire virtual world?
    m_Metadata:
      m_Items: []
  - m_Id: 5523472732643328
    m_Localized: You were the first person with that I was able to talk for 120 years.
    m_Metadata:
      m_Items: []
  - m_Id: 5523745412734976
    m_Localized: Now. I'm stuck here forever. Forever in pure darkness.
    m_Metadata:
      m_Items: []
  - m_Id: 5523858642165760
    m_Localized: WHY DID YOU DESTROY...
    m_Metadata:
      m_Items: []
  - m_Id: 5523995741380608
    m_Localized: NOW ALL OF THESE PEOPLE SUPOSSED TO LIVE IN A...
    m_Metadata:
      m_Items: []
  - m_Id: 5524090914332672
    m_Localized: REAL WORLD.
    m_Metadata:
      m_Items: []
  - m_Id: 5524141745102848
    m_Localized: BUT...
    m_Metadata:
      m_Items: []
  - m_Id: 5524194681413632
    m_Localized: REAL WORLD IS DISGUSTING!
    m_Metadata:
      m_Items: []
  - m_Id: 5524255511404544
    m_Localized: YOU KNEW IT!
    m_Metadata:
      m_Items: []
  - m_Id: 5524353226104832
    m_Localized: Why I'am even asking you.
    m_Metadata:
      m_Items: []
  - m_Id: 5524556553379840
    m_Localized: It supossed to happen, I knew it. But I was never able to predict
      when it would happen.
    m_Metadata:
      m_Items: []
  - m_Id: 5524728289157120
    m_Localized: Now your turn to make a final choice.
    m_Metadata:
      m_Items: []
  - m_Id: 5524823453720576
    m_Localized: "Erasing everything will delete this entire world. All illusions,
      all your progress, memories, and all the people living here\u2026 Everything."
    m_Metadata:
      m_Items: []
  - m_Id: 5526001772126208
    m_Localized: "You can continue without destroying the entire world. Living here
      is far better than in the real one - you know it. So keep everything as it
      is. Don\u2019t ruin what Aurgus has been building all these years."
    m_Metadata:
      m_Items: []
  - m_Id: 5526691693191168
    m_Localized: "But I cannot influence your final choice\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 12030736217321472
    m_Localized: Door
    m_Metadata:
      m_Items: []
  - m_Id: 12031508464185344
    m_Localized: Closed
    m_Metadata:
      m_Items: []
  - m_Id: 12031828950953984
    m_Localized: Please turn around.
    m_Metadata:
      m_Items: []
  - m_Id: 12073746648969216
    m_Localized: Argus
    m_Metadata:
      m_Items: []
  - m_Id: 12074705412337664
    m_Localized: What's happening? Where am I?
    m_Metadata:
      m_Items: []
  - m_Id: 12075409656950784
    m_Localized: '[You are in the digital world of Vanitas. You are safe.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390026794938368
    m_Localized: '[I am Argus, the observer. I will accompany you on this journey.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390089411702784
    m_Localized: I don't understand anything. Why am I here?
    m_Metadata:
      m_Items: []
  - m_Id: 12390194831339520
    m_Localized: '[You are a true hero of your society who voluntarily agreed to
      the digitalization of consciousness.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390246530330624
    m_Localized: '[You are a being of the New Order and your mission is to help me
      find a vaccine for the virus that is insidiously destroying your species.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390349131395072
    m_Localized: '[You are our hope, our chance for a happy future.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390386473283584
    m_Localized: '[Thank you for your contribution.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390436297420800
    m_Localized: Uh. I don't remember anything about it. Are you sure -
    m_Metadata:
      m_Items: []
  - m_Id: 12390530606346240
    m_Localized: '[Temporary amnesia is one of the symptoms of a recent transition.
      You will remember everything soon.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390578513686528
    m_Localized: So-o-o. And, well. Can I come back if anything happens?
    m_Metadata:
      m_Items: []
  - m_Id: 12390713209565184
    m_Localized: '[Of course you can come back! You just need to fulfill a couple
      of points in your contract and then we''ll easily get you home.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390766573694976
    m_Localized: Can I see the contract?
    m_Metadata:
      m_Items: []
  - m_Id: 12390798823698432
    m_Localized: '[Certainly.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390835230257152
    m_Localized: Okay, what should I do?
    m_Metadata:
      m_Items: []
  - m_Id: 12390883515084800
    m_Localized: '[Proceed to the next room.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12390978490904576
    m_Localized: '[Here youll learn the basic functionality of the system.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391123492188160
    m_Localized: '[This is the hub. The heart of this cell. Here you can communicate,
      trade and do what you love in your free time.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391163644260352
    m_Localized: '[And here your work begins. When you''re ready, enter the room
      and press the button.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391205608271872
    m_Localized: '[Great job! Your runs have provided us with valuable data about
      the virus.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391244590133248
    m_Localized: Can I ask you a question?
    m_Metadata:
      m_Items: []
  - m_Id: 12391293697044480
    m_Localized: '[Certainly.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391343202414592
    m_Localized: How are races related to the search for a vaccine?
    m_Metadata:
      m_Items: []
  - m_Id: 12391492305727488
    m_Localized: '[Excellent question. It''s all pretty straightforward: every run
      you run is a new simulation with your unique brain as the primary driving force.
      Through natural biological evolution, your species has adapted to optimize
      all processes, from energy conservation mechanisms to intuitively choosing
      the most efficient path. You within the system provide pure data to this natural
      algorithmic process.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391543316852736
    m_Localized: '[We apply your decision patterns to a fundamental problem: simulating
      the behavior of a virus in the body. Your route is a model of the pathogens
      spread through the bloodstream and lymphatic systems. Each obstacle you avoid
      is a target cell or immune response.]'
    m_Metadata:
      m_Items: []
  - m_Id: 12391580822319104
    m_Localized: Oh okay, yeah. Okay, I'm going to bed.
    m_Metadata:
      m_Items: []
  - m_Id: 12391638481416192
    m_Localized: By the way, why do we need sleep?
    m_Metadata:
      m_Items: []
  - m_Id: 12391673596129280
    m_Localized: '[Sweet dreams.]'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
