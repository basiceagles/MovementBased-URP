  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NPCDialogues_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: fe9b4044e4be1b641ac317d4f863bb2d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 30772027392
    m_Localized: You have died to a loss of time.
    m_Metadata:
      m_Items: []
  - m_Id: 550312075264
    m_Localized: What did you expect? Next time try to be faster.
    m_Metadata:
      m_Items: []
  - m_Id: 555143913472
    m_Localized: Don't worry. Aurgus cannot see us here. Also I have something for
      you...
    m_Metadata:
      m_Items: []
  - m_Id: 577637965824
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 39704643231744
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 39639769931776
    m_Localized: Next time can you watch your step and don't jump from high heights.
    m_Metadata:
      m_Items: []
  - m_Id: 39694354604032
    m_Localized: This is a small advice from me.
    m_Metadata:
      m_Items: []
  - m_Id: 40959943892992
    m_Localized: You have died to a Rush.
    m_Metadata:
      m_Items: []
  - m_Id: 40991183069184
    m_Localized: Rush is fast, but next time try to find a shelter faster that it
      will catch you.
    m_Metadata:
      m_Items: []
  - m_Id: 41004558704640
    m_Localized: So what you will choice?
    m_Metadata:
      m_Items: []
  - m_Id: 50544071139328
    m_Localized: Hello!
    m_Metadata:
      m_Items: []
  - m_Id: 50636098363392
    m_Localized: Do you want buy some perks?
    m_Metadata:
      m_Items: []
  - m_Id: 50514983641088
    m_Localized: Shopper
    m_Metadata:
      m_Items: []
  - m_Id: 5523247154585600
    m_Localized: Did you realise what happened?
    m_Metadata:
      m_Items: []
  - m_Id: 5523343371919360
    m_Localized: Why you did this?
    m_Metadata:
      m_Items: []
  - m_Id: 5523383284916224
    m_Localized: Why you did destroy the entire virtual world?
    m_Metadata:
      m_Items: []
  - m_Id: 5523472732643328
    m_Localized: You were the first person with that I was able to talk for 120 years.
    m_Metadata:
      m_Items: []
  - m_Id: 5523745412734976
    m_Localized: Now. I'm stuck here forever. Forever in pure darkness.
    m_Metadata:
      m_Items: []
  - m_Id: 5523858642165760
    m_Localized: WHY DID YOU DESTROY...
    m_Metadata:
      m_Items: []
  - m_Id: 5523995741380608
    m_Localized: NOW ALL OF THESE PEOPLE SUPOSSED TO LIVE IN A...
    m_Metadata:
      m_Items: []
  - m_Id: 5524090914332672
    m_Localized: REAL WORLD.
    m_Metadata:
      m_Items: []
  - m_Id: 5524141745102848
    m_Localized: BUT...
    m_Metadata:
      m_Items: []
  - m_Id: 5524194681413632
    m_Localized: REAL WORLD IS DISGUSTING!
    m_Metadata:
      m_Items: []
  - m_Id: 5524255511404544
    m_Localized: YOU KNEW IT!
    m_Metadata:
      m_Items: []
  - m_Id: 5524353226104832
    m_Localized: Why I'am even asking you.
    m_Metadata:
      m_Items: []
  - m_Id: 5524556553379840
    m_Localized: It supossed to happen, I knew it. But I was never able to predict
      when it would happen.
    m_Metadata:
      m_Items: []
  - m_Id: 5524728289157120
    m_Localized: Now your turn to make a final choice.
    m_Metadata:
      m_Items: []
  - m_Id: 5524823453720576
    m_Localized: "Erasing everything will delete this entire world. All illusions,
      all your progress, memories, and all the people living here\u2026 Everything."
    m_Metadata:
      m_Items: []
  - m_Id: 5526001772126208
    m_Localized: "You can continue without destroying the entire world. Living here
      is far better than in the real one - you know it. So keep everything as it
      is. Don\u2019t ruin what Aurgus has been building all these years."
    m_Metadata:
      m_Items: []
  - m_Id: 5526691693191168
    m_Localized: "But I cannot influence your final choice\u2026"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
